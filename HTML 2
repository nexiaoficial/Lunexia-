  saveHistory();

  showToast("Arte limpa.");

}

/* =====================================================
   DESFAZER / REFAZER
===================================================== */

function getCanvasState(){

  return designCanvas.innerHTML;

}

function restoreCanvasState(state){

  designCanvas.innerHTML=state;

  selectedElement=null;

  designCanvas
    .querySelectorAll(".design-element")
    .forEach(el=>{

      makeDraggable(el);

      el.addEventListener("click",function(e){

        e.stopPropagation();

        selectElement(el);

      });

    });

  const hasElements=
    designCanvas.querySelector(".design-element");

  document.getElementById("emptyCanvas").style.display=
    hasElements ? "none":"grid";

}

function saveHistory(){

  const state=getCanvasState();

  if(history.length===0 ||
     history[history.length-1]!==state){

    history.push(state);

    if(history.length>30){

      history.shift();

    }

  }

  redoHistory=[];

}

function undoPhoto(){

  if(history.length<=1){

    showToast("Nada para desfazer.");

    return;

  }

  const current=history.pop();

  redoHistory.push(current);

  const previous=
    history[history.length-1];

  restoreCanvasState(previous);

  showToast("Desfeito.");

}

function redoPhoto(){

  if(!redoHistory.length){

    showToast("Nada para refazer.");

    return;

  }

  const state=redoHistory.pop();

  history.push(state);

  restoreCanvasState(state);

  showToast("Refeito.");

}

/* =====================================================
   EXPORTAR PNG
===================================================== */

async function downloadDesign(){

  const canvas=document.getElementById("designCanvas");

  showToast("Preparando PNG...");

  /*
   A exportação abaixo usa SVG + foreignObject.
   Funciona em navegadores modernos.
  */

  const clone=canvas.cloneNode(true);

  clone.querySelectorAll(".selected")
    .forEach(el=>el.classList.remove("selected"));

  clone.querySelectorAll(".empty-canvas")
    .forEach(el=>el.remove());

  const width=canvas.offsetWidth;
  const height=canvas.offsetHeight;

  const serializer=
    new XMLSerializer();

  const html=
    serializer.serializeToString(clone);

  const svg=`
    <svg xmlns="http://www.w3.org/2000/svg"
         width="${width}"
         height="${height}">
      <foreignObject
        width="100%"
        height="100%">
        <div xmlns="http://www.w3.org/1999/xhtml">
          ${html}
        </div>
      </foreignObject>
    </svg>
  `;

  const blob=
    new Blob([svg],{
      type:"image/svg+xml;charset=utf-8"
    });

  const url=
    URL.createObjectURL(blob);

  const image=new Image();

  image.onload=function(){

    const output=
      document.createElement("canvas");

    output.width=width*2;
    output.height=height*2;

    const ctx=
      output.getContext("2d");

    ctx.scale(2,2);

    ctx.drawImage(
      image,
      0,
      0,
      width,
      height
    );

    URL.revokeObjectURL(url);

    output.toBlob(function(png){

      const link=
        document.createElement("a");

      link.download=
        "lunexia-design.png";

      link.href=
        URL.createObjectURL(png);

      link.click();

      showToast("PNG baixado.");

    },"image/png");

  };

  image.onerror=function(){

    showToast(
      "O navegador não conseguiu exportar esta arte."
    );

  };

  image.src=url;

}

