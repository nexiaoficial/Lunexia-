}

/* LIMPAR */

function clearDesign(){

  if(!confirm("Limpar toda a arte?"))return;

  designCanvas.querySelectorAll(
    ".design-element"
  ).forEach(el=>el.remove());

  selectedElement=null;

  document.getElementById("emptyCanvas").style.display=
