<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Lunexia 2026</title>

<style>
:root{
  --bg:#0b1020;
  --bg-soft:#111827;
  --panel:rgba(17,24,39,.82);
  --panel-strong:rgba(15,23,42,.96);
  --ink:#e5eefb;
  --muted:#95a7c2;
  --line:rgba(148,163,184,.18);
  --brand:#7c6cff;
  --brand-2:#9b8cff;
  --brand-3:#4dd4c5;
  --danger:#ef4444;
  --success:#22c55e;
  --shadow:0 18px 42px rgba(2,6,23,.42);
  --radius:22px;
  --sidebar-w:268px;
}

*{box-sizing:border-box}

html{
  scroll-behavior:smooth;
}

body{
  margin:0;
  font-family:Inter,"Segoe UI",system-ui,-apple-system,sans-serif;
  background:linear-gradient(180deg,#0b1020,#0c1324 18%,#0f172a 100%);
  color:var(--ink);
  min-height:100vh;
}

button,input,textarea,select{
  font:inherit;
}

button{
  cursor:pointer;
  border:none;
  outline:none;
}

.app{
  display:flex;
  min-height:100vh;
  background:var(--bg);
}

.sidebar{
  width:var(--sidebar-w);
  padding:22px 18px 18px;
  background:rgba(11,16,32,.98);
  color:var(--ink);
  position:fixed;
  inset:0 auto 0 0;
  z-index:20;
  border-right:1px solid var(--line);
  backdrop-filter:blur(12px);
  transition:.28s ease;
}

.brand{
  display:flex;
  align-items:center;
  gap:12px;
  padding:6px 8px 18px;
  font-weight:900;
  letter-spacing:-.04em;
  font-size:26px;
}

.brand-mark{
  position:relative;
  width:42px;
  height:42px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:radial-gradient(circle at 35% 30%,#f9f7ff,#efe8ff 16%,#d9d2ff 36%,#b7a8ff 62%,#7c6cff);
  box-shadow:0 12px 28px rgba(124,108,255,.35),inset -10px -10px 16px rgba(51,34,118,.35);
  flex-shrink:0;
}

.brand-mark:before{
  content:"";
  position:absolute;
  inset:0;
  border-radius:50%;
  background:rgba(11,16,32,.7);
  transform:translateX(9px);
}

.brand-mark:after{
  content:"";
  position:absolute;
  inset:-8px;
  border-radius:50%;
  border:1.5px solid rgba(184,172,255,.6);
  transform:scale(1.16);
}

.brand-mark .orbit-dot,
.brand-mark .orbit-star,
.brand-mark .orbit-card{
  position:absolute;
  display:block;
}

.orbit-dot{
  width:7px;
  height:7px;
  right:6px;
  top:8px;
  border-radius:50%;
  background:#a393ff;
  box-shadow:0 0 12px #a393ff;
}

.orbit-star{
  width:9px;
  height:9px;
  left:20px;
  top:-3px;
  border-radius:50%;
  background:#f7d87a;
  box-shadow:0 0 12px #f7d87a;
}

.orbit-card{
  width:14px;
  height:8px;
  left:4px;
  bottom:8px;
  border-radius:6px;
  background:rgba(255,255,255,.8);
}

.brand span{
  color:var(--brand-2);
}

.nav{
  display:flex;
  flex-direction:column;
  gap:8px;
  margin-top:18px;
}

.nav-btn{
  width:100%;
  display:flex;
  align-items:center;
  gap:12px;
  background:transparent;
  color:var(--ink);
  border-radius:14px;
  padding:12px 14px;
  font-weight:600;
  text-align:left;
  border:1px solid transparent;
  transition:.2s;
}

.nav-btn:hover,
.nav-btn.active{
  background:linear-gradient(135deg,rgba(124,108,255,.18),rgba(124,108,255,.08));
  color:#fff;
  border-color:rgba(124,108,255,.2);
}

.main{
  flex:1;
  margin-left:var(--sidebar-w);
  padding:28px 30px 40px;
  min-width:0;
}

.topbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:18px;
  margin-bottom:24px;
}

.title-wrap h1{
  margin:0;
  font-size:clamp(2rem,2vw,2.7rem);
  letter-spacing:-.05em;
}

.sub{
  margin-top:6px;
  color:var(--muted);
}

.top-actions{
  display:flex;
  align-items:center;
  gap:10px;
}

.pill-btn,
.ghost-btn{
  background:rgba(148,163,184,.08);
  border:1px solid var(--line);
  color:var(--ink);
  padding:10px 16px;
  border-radius:12px;
  font-weight:700;
}

.avatar{
  width:42px;
  height:42px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:linear-gradient(135deg,var(--brand),#a855f7);
  color:#fff;
  font-weight:800;
}

.icon-btn{
  display:inline-grid;
  place-items:center;
  width:40px;
  height:40px;
  padding:0;
  background:rgba(148,163,184,.08);
  color:var(--ink);
  border:1px solid var(--line);
  border-radius:12px;
}

.mobile-toggle{
  display:none;
}

.view{
  display:none;
}

.view.active{
  display:block;
  animation:fadeIn .22s ease;
}

@keyframes fadeIn{
  from{opacity:0;transform:translateY(6px)}
  to{opacity:1;transform:translateY(0)}
}

.hero,
.card,
.stat-card,
.template-card,
.project-card,
.panel,
.modal-box,
.settings-box{
  background:rgba(17,24,39,.82);
  border:1px solid var(--line);
  border-radius:var(--radius);
  box-shadow:var(--shadow);
  backdrop-filter:blur(14px);
}

.hero{
  padding:24px;
  position:relative;
  overflow:hidden;
}

.hero h2{
  margin:0 0 8px;
  font-size:clamp(1.5rem,1.7vw,2.2rem);
}

.hero p{
  margin:0;
  max-width:700px;
  color:var(--muted);
}

.hero-row{
  display:flex;
  gap:12px;
  margin-top:18px;
}

.hero input{
  flex:1;
  min-width:0;
  border:1px solid var(--line);
  background:rgba(15,23,42,.88);
  color:var(--ink);
  padding:16px 18px;
  border-radius:15px;
}

.primary-btn{
  background:linear-gradient(135deg,var(--brand),var(--brand-2));
  color:#fff;
  box-shadow:0 10px 28px rgba(124,108,255,.2);
  border-radius:12px;
  padding:12px 16px;
  font-weight:700;
}

.danger-btn{
  background:rgba(239,68,68,.12);
  color:#fca5a5;
  border:1px solid rgba(239,68,68,.2);
  border-radius:12px;
  padding:12px 16px;
  font-weight:700;
}

.small-btn{
  background:rgba(124,108,255,.12);
  color:#d9d2ff;
  border:1px solid rgba(124,108,255,.2);
  border-radius:10px;
  padding:9px 12px;
  font-weight:700;
}

.stats{
  margin-top:20px;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:16px;
}

.stat-card{
  padding:18px 20px;
}

.stat-label{
  font-size:.75rem;
  text-transform:uppercase;
  letter-spacing:.08em;
  color:var(--muted);
}

.stat-value{
  font-size:2rem;
  font-weight:800;
  margin-top:10px;
}

.section-header{
  margin:28px 0 14px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:16px;
}

.section-header h2{
  margin:0;
}

.cards-grid,
.project-grid{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:16px;
}

.template-card,
.project-card{
  padding:22px 18px;
  cursor:pointer;
  transition:.18s;
}

.template-card:hover,
.project-card:hover{
  transform:translateY(-3px);
}

.template-emoji,
.project-card .emoji{
  font-size:2rem;
  margin-bottom:10px;
}

.template-card h3,
.project-card h3{
  margin:0 0 8px;
}

.muted{
  color:var(--muted);
}

/* OFFICE */

.officebar{
  display:flex;
  align-items:center;
  gap:12px;
  background:rgba(17,24,39,.9);
  border:1px solid var(--line);
  border-radius:18px 18px 0 0;
  padding:12px 14px;
}

.brand-mini{
  width:32px;
  height:32px;
  border-radius:12px;
  display:grid;
  place-items:center;
  color:#fff;
  font-weight:900;
}

.brand-mini.word{background:linear-gradient(135deg,#3b82f6,#60a5fa)}
.brand-mini.sheet{background:linear-gradient(135deg,#10b981,#34d399)}
.brand-mini.slide{background:linear-gradient(135deg,#f97316,#fbbf24)}

.office-title{
  font-weight:800;
}

.header{
  flex:1;
  display:flex;
  justify-content:space-between;
}

.toolbar{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  background:rgba(17,24,39,.8);
  border:1px solid var(--line);
  border-top:none;
  padding:10px 14px;
  border-radius:0 0 18px 18px;
}

.toolbar button,
.toolbar select{
  background:rgba(148,163,184,.06);
  color:var(--ink);
  border:1px solid var(--line);
  border-radius:10px;
  padding:8px 10px;
}

.workspace{
  margin-top:16px;
  display:grid;
  grid-template-columns:minmax(0,1fr) 240px;
  gap:18px;
}

.doc-panel,
.sheet-panel,
.panel{
  padding:18px;
}

.doc-shell{
  background:rgba(15,23,42,.9);
  min-height:760px;
  border-radius:18px;
  border:1px solid var(--line);
}

.doc-editor{
  width:100%;
  min-height:760px;
  padding:42px 46px;
  font-size:1.02rem;
  line-height:1.8;
  outline:none;
  color:var(--ink);
}

.mini-card{
  padding:16px;
  background:rgba(17,24,39,.82);
  border:1px solid var(--line);
  border-radius:18px;
  margin-bottom:14px;
}

.counter{
  font-size:2rem;
  font-weight:800;
}

.formula-bar{
  display:flex;
  gap:10px;
  margin-bottom:14px;
  padding:8px 10px;
  background:rgba(148,163,184,.05);
  border:1px solid var(--line);
  border-radius:12px;
}

.cell-indicator{
  min-width:62px;
  text-align:center;
  padding:8px;
  border:1px solid var(--line);
  border-radius:8px;
}

.formula-bar input{
  flex:1;
  min-width:0;
  border:none;
  outline:none;
  background:transparent;
  color:var(--ink);
}

.table-wrap{
  overflow:auto;
  border-radius:16px;
  border:1px solid var(--line);
}

table.sheet{
  width:100%;
  min-width:820px;
  border-collapse:collapse;
}

.sheet th,
.sheet td{
  border:1px solid rgba(148,163,184,.25);
  min-width:110px;
  height:34px;
  padding:7px 8px;
  text-align:left;
  color:var(--ink);
}

.sheet th{
  background:rgba(148,163,184,.08);
}

/* SLIDES */

.ppt-workspace{
  margin-top:16px;
  display:grid;
  grid-template-columns:180px minmax(0,1fr);
  gap:18px;
}

.thumb-list{
  display:flex;
  flex-direction:column;
  gap:10px;
  max-height:700px;
  overflow:auto;
}

.thumb{
  padding:10px;
  background:rgba(17,24,39,.8);
  border:1px solid var(--line);
  border-radius:14px;
  cursor:pointer;
}

.thumb.active{
  border-color:var(--brand);
}

.thumb-preview{
  min-height:80px;
  border-radius:10px;
  background:linear-gradient(135deg,#121926,#182235);
  padding:10px;
  font-size:.7rem;
}

.slide-stage{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:12px;
}

.slide-canvas{
  width:min(100%,980px);
  min-height:530px;
  background:linear-gradient(135deg,#121926,#0f151d);
  border:1px solid var(--line);
  border-radius:24px;
  padding:52px 50px;
  outline:none;
}

/* SETTINGS */

.settings-box{
  max-width:620px;
  padding:22px;
  margin-top:18px;
}

.field{
  display:grid;
  gap:10px;
  margin:16px 0;
}

.field label{
  font-weight:700;
}

.field input,
.field textarea{
  width:100%;
  border:1px solid var(--line);
  border-radius:12px;
  padding:12px 14px;
  background:rgba(17,24,39,.7);
  color:var(--ink);
}

/* =========================
   EDITOR DE FOTOS LUNEXIA
========================= */

.photo-layout{
  margin-top:16px;
  display:grid;
  grid-template-columns:230px minmax(0,1fr) 250px;
  gap:16px;
}

.photo-sidebar,
.photo-tools{
  background:rgba(17,24,39,.86);
  border:1px solid var(--line);
  border-radius:20px;
  padding:16px;
  box-shadow:var(--shadow);
}

.photo-sidebar h3,
.photo-tools h3{
  margin:0 0 14px;
}

.tool-group{
  display:grid;
  gap:8px;
  margin-bottom:18px;
}

.tool-group-title{
  color:var(--muted);
  font-size:.75rem;
  text-transform:uppercase;
  letter-spacing:.08em;
}

.tool-btn{
  width:100%;
  text-align:left;
  padding:11px 12px;
  border-radius:12px;
  background:rgba(148,163,184,.06);
  border:1px solid var(--line);
  color:var(--ink);
}

.tool-btn:hover{
  background:rgba(124,108,255,.15);
  border-color:rgba(124,108,255,.3);
}

.upload-box{
  border:1px dashed rgba(124,108,255,.55);
  border-radius:16px;
  padding:18px 12px;
  text-align:center;
  background:rgba(124,108,255,.06);
  cursor:pointer;
  margin-bottom:16px;
}

.upload-box:hover{
  background:rgba(124,108,255,.12);
}

#photoInput{
  display:none;
}

.canvas-area{
  min-height:650px;
  background:
    linear-gradient(45deg,#151c2b 25%,transparent 25%),
    linear-gradient(-45deg,#151c2b 25%,transparent 25%),
    linear-gradient(45deg,transparent 75%,#151c2b 75%),
    linear-gradient(-45deg,transparent 75%,#151c2b 75%);
  background-size:24px 24px;
  background-position:0 0,0 12px,12px -12px,-12px 0;
  border:1px solid var(--line);
  border-radius:20px;
  padding:24px;
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
  position:relative;
}

#designCanvas{
  position:relative;
  width:min(100%,850px);
  height:560px;
  background:#fff;
  overflow:hidden;
  border-radius:8px;
  box-shadow:0 20px 60px rgba(0,0,0,.4);
  transform-origin:center;
}

.design-element{
  position:absolute;
  user-select:none;
  touch-action:none;
  cursor:move;
}

.design-element.selected{
  outline:2px solid var(--brand);
  outline-offset:2px;
}

.design-image{
  max-width:100%;
  max-height:100%;
  object-fit:contain;
  display:block;
}

.design-text{
  min-width:80px;
  min-height:30px;
  padding:5px;
  color:#111827;
  font-weight:700;
  white-space:pre-wrap;
}

.design-shape{
  width:140px;
  height:100px;
  border-radius:18px;
  background:linear-gradient(135deg,#7c6cff,#a393ff);
}

.design-circle{
  width:120px;
  height:120px;
  border-radius:50%;
  background:linear-gradient(135deg,#4dd4c5,#7c6cff);
}

.empty-canvas{
  position:absolute;
  inset:0;
  display:grid;
  place-items:center;
  color:#6b7280;
  pointer-events:none;
  text-align:center;
  padding:30px;
}

.range-row{
  display:grid;
  gap:6px;
  margin-bottom:12px;
}

.range-row label{
  display:flex;
  justify-content:space-between;
  font-size:.82rem;
  color:var(--muted);
}

.range-row input{
  width:100%;
}

.photo-preview{
  min-height:120px;
  border:1px solid var(--line);
  border-radius:14px;
  display:grid;
  place-items:center;
  overflow:hidden;
  background:#111827;
  margin-bottom:12px;
}

.photo-preview img{
  max-width:100%;
  max-height:140px;
}

.filter-buttons{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:7px;
}

.filter-buttons button{
  padding:9px 5px;
  border-radius:9px;
  color:var(--ink);
  background:rgba(148,163,184,.07);
  border:1px solid var(--line);
  font-size:.78rem;
}

.editor-status{
  margin-top:10px;
  color:var(--muted);
  font-size:.8rem;
  text-align:center;
}

/* MODAIS */

.modal,
.login{
  position:fixed;
  inset:0;
  display:none;
  align-items:center;
  justify-content:center;
  background:rgba(2,6,23,.7);
  z-index:50;
  padding:20px;
}

.modal.show,
.login.show{
  display:flex;
}

.modal-box,
.login-box{
  width:min(560px,100%);
  padding:24px;
  background:rgba(17,24,39,.96);
}

.modal-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.modal textarea{
  width:100%;
  min-height:130px;
  margin:14px 0;
  border:1px solid var(--line);
  border-radius:14px;
  padding:14px;
  background:rgba(15,23,42,.7);
  color:var(--ink);
}

.toast{
  position:fixed;
  right:22px;
  bottom:22px;
  background:rgba(15,23,42,.96);
  color:white;
  border-radius:12px;
  padding:12px 16px;
  box-shadow:0 18px 40px rgba(2,6,23,.35);
  display:none;
  z-index:100;
}

/* MOBILE */

@media(max-width:1100px){
  .sidebar{
    transform:translateX(-110%);
    width:min(82vw,310px);
  }

  .sidebar.open{
    transform:translateX(0);
  }

  .main{
    margin-left:0;
    padding:20px 18px 30px;
  }

  .mobile-toggle{
    display:inline-grid;
  }

  .mobile-backdrop{
    position:fixed;
    inset:0;
    background:rgba(2,6,23,.6);
    opacity:0;
    pointer-events:none;
    z-index:15;
  }

  .mobile-backdrop.show{
    opacity:1;
    pointer-events:auto;
  }

  .photo-layout{
    grid-template-columns:1fr;
  }

  .photo-sidebar,
  .photo-tools{
    order:initial;
  }
}

@media(max-width:850px){
  .cards-grid,
  .project-grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

  .stats{
    grid-template-columns:1fr;
  }

  .workspace,
  .ppt-workspace{
    grid-template-columns:1fr;
  }

  .photo-sidebar{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
  }
}

@media(max-width:640px){
  .topbar{
    align-items:flex-start;
    flex-direction:column;
  }

  .hero-row{
    flex-direction:column;
  }

  .primary-btn{
    width:100%;
  }

  .cards-grid,
  .project-grid{
    grid-template-columns:1fr;
  }

  .doc-editor{
    padding:24px 20px;
  }

  .slide-canvas{
    min-height:420px;
    padding:30px 24px;
  }

  .canvas-area{
    padding:10px;
    min-height:480px;
  }

  #designCanvas{
    height:460px;
  }

  .photo-sidebar{
    display:block;
  }

  .photo-tools{
    padding:12px;
  }
}
</style>
</head>

<body>

<div class="mobile-backdrop" id="mobileBackdrop"></div>

<div class="app">

<aside class="sidebar" id="sidebar">

  <div class="brand">
    <div class="brand-mark" aria-label="Logotipo Lunexia">
      <span class="orbit-star"></span>
      <span class="orbit-card"></span>
      <span class="orbit-dot"></span>
    </div>
    <div class="brand-text">Lunexia<span>.</span></div>
  </div>

  <nav class="nav">

    <button class="nav-btn active" data-view="home">
      <span>🏠</span><span>Início</span>
    </button>

    <button class="nav-btn" data-view="docs">
      <span>📄</span><span>Documentos</span>
    </button>

    <button class="nav-btn" data-view="sheets">
      <span>📊</span><span>Planilhas</span>
    </button>

    <button class="nav-btn" data-view="slides">
      <span>🎨</span><span>Slides</span>
    </button>

    <button class="nav-btn" data-view="photos">
      <span>🖼️</span><span>Editor de fotos</span>
    </button>

    <button class="nav-btn" data-view="projects">
      <span>📁</span><span>Projetos</span>
    </button>

    <button class="nav-btn" data-view="settings">
      <span>⚙️</span><span>Configurações</span>
    </button>

  </nav>

</aside>

<main class="main">

