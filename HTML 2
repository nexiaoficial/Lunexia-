<script>

const navButtons=document.querySelectorAll(".nav-btn");
const views=document.querySelectorAll(".view");

const docEditor=document.getElementById("docEditor");
const wordCount=document.getElementById("wordCount");

const slideCanvas=document.getElementById("slideCanvas");
const slideThumbs=document.getElementById("slideThumbs");

const designCanvas=document.getElementById("designCanvas");
const photoInput=document.getElementById("photoInput");

let selectedElement=null;
let history=[];
let redoHistory=[];

let projects=0;
let documents=0;

/* ================= NAVEGAÇÃO ================= */

navButtons.forEach(btn=>{

  btn.addEventListener("click",()=>{

    navButtons.forEach(b=>{
      b.classList.toggle("active",b===btn);
    });

    const target=btn.dataset.view;

    views.forEach(v=>{
      v.classList.toggle("active",v.id===target);
    });

    if(target==="photos"){
      updateEditorPreview();
    }

    document.getElementById("sidebar").classList.remove("open");
    document.getElementById("mobileBackdrop").classList.remove("show");

  });

});

/* ================= TOAST ================= */

function showToast(message){

  const toast=document.getElementById("toast");

  toast.textContent=message;
  toast.style.display="block";

  clearTimeout(showToast.timer);

  showToast.timer=setTimeout(()=>{
    toast.style.display="none";
  },2200);

}

/* ================= LOGIN ================= */

function openLogin(){
  document.getElementById("loginModal").classList.add("show");
}

function closeLogin(){

  document.getElementById("loginModal").classList.remove("show");

  showToast("Conta atualizada.");

}

/* ================= IA DOCUMENTO ================= */

function openAI(){
  document.getElementById("aiModal").classList.add("show");
}

function closeAI(){
  document.getElementById("aiModal").classList.remove("show");
}

function generateFromAI(){

  const input=document.getElementById("aiPrompt");
  const modalInput=document.getElementById("aiOutput");

  const prompt=(input?.value || modalInput?.value || "").trim();

  if(!prompt){

    showToast("Descreva o que deseja criar.");

    return;
  }

  closeAI();

  if(docEditor){

    docEditor.innerHTML=`
      <h1>Resultado da IA</h1>
      <p>${escapeHTML(prompt)}</p>
      <p>
        Este conteúdo foi estruturado a partir da sua solicitação.
        Você pode editar livremente o resultado.
      </p>
    `;

  }

  documents++;

  updateStats();

  showToast("Conteúdo criado.");

}

/* ================= DOCUMENTOS ================= */

function execDoc(command,value=null){

  document.execCommand(command,false,value);

  updateWordCount();

}

function updateWordCount(){

  if(!docEditor)return;

  const text=docEditor.innerText.trim();

  wordCount.textContent=
    text ? text.split(/\s+/).length : 0;

}

docEditor.addEventListener("input",updateWordCount);

function newDoc(){

  documents++;

  updateStats();

  docEditor.innerHTML=`
    <h1>Seu novo documento</h1>
    <p>Escreva aqui...</p>
  `;

  goTo("docs");

  updateWordCount();

  showToast("Novo documento criado.");

}

/* ================= PLANILHAS ================= */

function newSheet(){

  goTo("sheets");

  showToast("Nova planilha criada.");

}

function addRow(){

  const table=document.getElementById("sheetTable");
  const tbody=table.querySelector("tbody");

  const row=document.createElement("tr");

  for(let i=0;i<3;i++){

    const cell=document.createElement("td");

    cell.contentEditable=true;

    row.appendChild(cell);

  }

  tbody.appendChild(row);

  showToast("Linha adicionada.");

}

function addColumn(){

  const table=document.getElementById("sheetTable");

  for(const row of table.rows){

    const cell=document.createElement(
      row.rowIndex===0 ? "th" : "td"
    );

    cell.contentEditable=true;

    row.appendChild(cell);

  }

  showToast("Coluna adicionada.");

}

function sumSelected(){

  const cells=[...document.querySelectorAll("#sheetTable td")];

  let total=0;

  cells.forEach(cell=>{

    const number=parseFloat(cell.textContent.replace(",","."));

    if(!isNaN(number)) total+=number;

  });

  showToast("Soma: "+total);

}

/* ================= SLIDES ================= */

function newSlide(){

  goTo("slides");

  renderSlideThumbs();

  showToast("Novo slide criado.");

}

function addSlideText(){

  slideCanvas.innerHTML+=
    "<p>Nova linha de conteúdo.</p>";

  showToast("Texto adicionado.");

}

function addSlideShape(){

  const block=document.createElement("div");

  block.style.width="160px";
  block.style.height="100px";
  block.style.borderRadius="18px";
  block.style.background=
    "linear-gradient(135deg,#7c6cff,#4dd4c5)";
  block.style.marginTop="20px";

  slideCanvas.appendChild(block);

  showToast("Bloco adicionado.");

}

function renderSlideThumbs(){

  slideThumbs.innerHTML="";

  for(let i=0;i<4;i++){

    const thumb=document.createElement("div");

    thumb.className="thumb";

    thumb.innerHTML=`
      <div class="thumb-preview">
        <strong>Slide ${i+1}</strong>
        <br><br>
        Design Lunexia
      </div>
    `;

    slideThumbs.appendChild(thumb);

  }

}

function downloadSlide(){

  showToast("Exportação de slide preparada.");

}

/* =====================================================
   EDITOR DE FOTOS
===================================================== */

/* IMPORTAR IMAGEM */

photoInput.addEventListener("change",function(e){

  const file=e.target.files[0];

  if(!file)return;

  const reader=new FileReader();

  reader.onload=function(event){

    addImageElement(event.target.result);

  };

  reader.readAsDataURL(file);

});

/* ADICIONAR IMAGEM */

function addImageElement(src){

  const img=document.createElement("img");

  img.src=src;

  img.className="design-element design-image";

  img.style.left="50px";
  img.style.top="50px";
  img.style.width="400px";
  img.style.transform="rotate(0deg)";
  img.dataset.rotation="0";

  designCanvas.appendChild(img);

  makeDraggable(img);

  selectElement(img);

  hideEmptyCanvas();

  saveHistory();

  updateEditorPreview();

  showToast("Foto adicionada.");

}

/* DRAG */

function makeDraggable(element){

  let startX=0;
  let startY=0;
  let startLeft=0;
  let startTop=0;
  let dragging=false;

  element.addEventListener("pointerdown",function(e){

    e.preventDefault();

    dragging=true;

    selectElement(element);

    startX=e.clientX;
    startY=e.clientY;

    startLeft=parseFloat(element.style.left)||0;
    startTop=parseFloat(element.style.top)||0;

    element.setPointerCapture(e.pointerId);

  });

  element.addEventListener("pointermove",function(e){

    if(!dragging)return;

    const dx=e.clientX-startX;
    const dy=e.clientY-startY;

    element.style.left=(startLeft+dx)+"px";
    element.style.top=(startTop+dy)+"px";

  });

  element.addEventListener("pointerup",function(){

    if(dragging){

      dragging=false;

      saveHistory();

    }

  });

}

/* SELECIONAR */

function selectElement(element){

  if(selectedElement){
    selectedElement.classList.remove("selected");
  }

  selectedElement=element;

  if(element){

    element.classList.add("selected");

    document.getElementById("editorStatus").textContent=
      "Elemento selecionado";

  }

  updateEditorPreview();

}

/* CLICK NO CANVAS */

designCanvas.addEventListener("pointerdown",function(e){

  if(e.target===designCanvas){

    if(selectedElement){

      selectedElement.classList.remove("selected");

    }

    selectedElement=null;

    document.getElementById("editorStatus").textContent=
      "Nenhum elemento selecionado";

  }

});

/* TEXTO */

function addTextElement(){

  const text=document.createElement("div");

  text.className="design-element design-text";

  text.textContent="Digite seu texto";

  text.contentEditable=true;

  text.style.left="80px";
  text.style.top="80px";
  text.style.fontSize="32px";
  text.style.color="#111827";

  designCanvas.appendChild(text);

  makeDraggable(text);

  selectElement(text);

  text.focus();

  saveHistory();

  hideEmptyCanvas();

}

/* QUADRADO */

function addRectangle(){

  const shape=document.createElement("div");

  shape.className=
    "design-element design-shape";

  shape.style.left="100px";
  shape.style.top="100px";

  designCanvas.appendChild(shape);

  makeDraggable(shape);

  selectElement(shape);

  saveHistory();

  hideEmptyCanvas();

}

/* CÍRCULO */

function addCircle(){

  const circle=document.createElement("div");

  circle.className=
    "design-element design-circle";

  circle.style.left="120px";
  circle.style.top="120px";

  designCanvas.appendChild(circle);

  makeDraggable(circle);

  selectElement(circle);

  saveHistory();

  hideEmptyCanvas();

}

/* EXCLUIR */

function deleteSelected(){

  if(!selectedElement){

    showToast("Selecione um elemento.");

    return;

  }

  selectedElement.remove();

  selectedElement=null;

  document.getElementById("editorStatus").textContent=
    "Nenhum elemento selecionado";

  saveHistory();

  updateEditorPreview();

  showToast("Elemento excluído.");

}

/* GIRAR */

function rotateSelected(){

  if(!selectedElement){

    showToast("Selecione um elemento.");

    return;

  }

  let rotation=
    parseFloat(selectedElement.dataset.rotation||0);

  rotation+=90;

  selectedElement.dataset.rotation=rotation;

  selectedElement.style.transform=
    `rotate(${rotation}deg)`;

  saveHistory();

}

/* REDIMENSIONAR */

function resizeSelected(multiplier){

  if(!selectedElement){

    showToast("Selecione um elemento.");

    return;

  }

  const rect=selectedElement.getBoundingClientRect();

  const parentRect=designCanvas.getBoundingClientRect();

  const currentWidth=
    parseFloat(selectedElement.style.width) ||
    (rect.width / parentRect.width*100)+"%";

  let numeric;

  if(typeof currentWidth==="string" &&
     currentWidth.includes("%")){

    numeric=
      parseFloat(currentWidth)*multiplier;

    selectedElement.style.width=
      numeric+"%";

  }else{

    numeric=
      parseFloat(currentWidth)*multiplier;

    selectedElement.style.width=
      numeric+"px";

  }

  saveHistory();

}

/* FILTROS */

function setFilter(type){

  if(!selectedElement ||
     selectedElement.tagName!=="IMG"){

    showToast("Selecione uma foto.");

    return;

  }

  let filter="";

  switch(type){

    case "grayscale":
      filter="grayscale(100%)";
      break;

    case "sepia":
      filter="sepia(90%)";
      break;

    case "vintage":
      filter=
        "sepia(35%) saturate(125%) contrast(105%)";
      break;

    case "cool":
      filter=
        "saturate(110%) contrast(105%) hue-rotate(12deg)";
      break;

    case "warm":
      filter=
        "sepia(20%) saturate(130%) contrast(105%)";
      break;

    default:
      filter="none";

  }

  selectedElement.dataset.filter=filter;

  applyImageAdjustments();

}

/* AJUSTES */

function applyImageAdjustments(){

  if(!selectedElement ||
     selectedElement.tagName!=="IMG"){

    return;

  }

  const brightness=
    document.getElementById("brightness").value;

  const contrast=
    document.getElementById("contrast").value;

  const saturation=
    document.getElementById("saturation").value;

  document.getElementById("brightnessValue").textContent=
    brightness+"%";

  document.getElementById("contrastValue").textContent=
    contrast+"%";

  document.getElementById("saturationValue").textContent=
    saturation+"%";

  const extra=
    selectedElement.dataset.filter || "none";

  selectedElement.style.filter=
    `${extra} brightness(${brightness}%)
     contrast(${contrast}%)
     saturate(${saturation}%)`;

  updateEditorPreview();

}

/* PREVIEW */

function updateEditorPreview(){

  const preview=document.getElementById("photoPreview");

  if(!selectedElement ||
     selectedElement.tagName!=="IMG"){

    preview.innerHTML=
      "Nenhuma imagem selecionada";

    return;

  }

  preview.innerHTML="";

  const clone=selectedElement.cloneNode(true);

  clone.classList.remove("selected");

  clone.style.position="relative";
  clone.style.left="auto";
  clone.style.top="auto";
  clone.style.width="100%";
  clone.style.height="auto";

  preview.appendChild(clone);

}

/* ESCONDER EMPTY */

function hideEmptyCanvas(){

